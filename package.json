{
  "name": "quizmind-yandex",
  "version": "1.0.0",
  "description": "Chrome extension optimized for Yandex Forms",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke-test.js",
